{
  "manifest_version": 3,
  "name": "OLX Anúncios Expirados",
  "version": "2.0.0",
  "description": "Lista e renova automaticamente todos os anúncios expirados da OLX (grátis)",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://conta.olx.com.br/*",
    "https://adquirir.olx.com.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OLX Expirados",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://conta.olx.com.br/anuncios*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://adquirir.olx.com.br/*"],
      "js": ["content_renewal.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
