{
  "manifest_version": 3,
  "name": "OLX Anúncios Expirados",
  "version": "1.0.0",
  "description": "Lista todos os anúncios expirados da sua conta OLX",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://conta.olx.com.br/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OLX Expirados",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://conta.olx.com.br/anuncios*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
